# Optional. Anonymous read-only Twitch IRC works without these values.
CHANNEL=somechannel
PORT=3000
ROUND_SECONDS=180
LOBBY_SECONDS=60
MIN_PLAYERS=6
TICK_MS=100

# Optional: enables chat announcements. Create a Twitch chat OAuth token for
# a bot account and use the matching account login name.
TWITCH_OAUTH=
TWITCH_NICK=

# Optional path for the local JSON leaderboard.
# LEADERBOARD_FILE=data/leaderboard.json
